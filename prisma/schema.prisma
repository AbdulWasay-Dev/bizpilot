generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("from-indigo-500 to-purple-500")
  accentColor String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts        Post[]
  decisions    Decision[]
  inventory    InventoryItem[]
  ideas        Idea[]
  transactions Transaction[]
  vendors      Vendor[]
}

model Post {
  id            String   @id @default(cuid())
  businessId    String
  date          Int
  title         String
  platform      String
  time          String
  status        String   @default("draft")
  platformColor String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Idea {
  id              String   @id @default(cuid())
  businessId      String
  title           String
  category        String
  impact          Int      @default(5)
  confidence      Int      @default(5)
  ease            Int      @default(5)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  businessId  String
  type        String   // SALE, EXPENSE, RETURN
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        String
  ref         String
  channel     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  sku         String
  category    String
  status      String   @default("AVAILABLE")
  cost        Decimal  @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  vendor      String
  payload     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Decision {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  status        String   @default("IN_DELIBERATION")
  urgency       String   @default("Medium")
  impact        String   @default("Medium")
  context       String?  @db.Text
  chosen        String?  @db.Text
  deadline      String
  kpi           String?
  outcomeRating Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Vendor {
  id         String   @id @default(cuid())
  businessId String
  name       String
  rating     Int      @default(5)
  whatsapp   String?
  telegram   String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
