generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("from-indigo-500 to-purple-500")
  accentColor String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts        Post[]
  decisions    Decision[]
  inventory    InventoryItem[]
  ideas        Idea[]
  transactions Transaction[]
  vendors      Vendor[]
  socialAccounts SocialAccount[]
}

model Post {
  id            String   @id @default(cuid())
  businessId    String
  date          Int
  title         String
  platform      String
  time          String
  status        String   @default("draft")
  platformColor String
  mediaUrl      String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Idea {
  id              String   @id @default(cuid())
  businessId      String
  title           String
  category        String
  impact          Int      @default(5)
  confidence      Int      @default(5)
  ease            Int      @default(5)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Transaction {
  id              String   @id @default(cuid())
  businessId      String
  type            String   // SALE, EXPENSE, RETURN
  description     String
  amount          Decimal  @db.Decimal(10, 2)
  date            String
  ref             String
  channel         String
  inventoryItemId String?
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  sku           String
  category      String
  productType   String   @default("digital") // physical | digital
  status        String   @default("AVAILABLE")
  quantity      Int      @default(1)
  cost          Decimal  @db.Decimal(10, 2)
  price         Decimal  @db.Decimal(10, 2)
  vendorId      String?
  vendor        String
  description   String?  @db.Text
  attributes    Json?    // [{key, value}]
  digitalFields Json?    // {type, licenseKey, email, password, ...}
  payload       String?  @db.Text
  tags          Json?    // string[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Decision {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  status        String   @default("IN_DELIBERATION")
  urgency       String   @default("Medium")
  impact        String   @default("Medium")
  context       String?  @db.Text
  chosen        String?  @db.Text
  deadline      String
  kpi           String?
  outcomeRating Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Vendor {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  rating         Int      @default(5)
  category       String?
  whatsapp       String?
  telegram       String?
  email          String?
  website        String?
  instagram      String?
  paymentMethods String?
  notes          String?  @db.Text
  tags           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id            String   @id @default(cuid())
  businessId    String
  platform      String
  username      String
  email         String
  password      String?
  recoveryEmail String?
  phoneLinked   String?
  devices       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
